{
  "name": "product-quality-workflow",
  "displayName": "Product Quality Workflow",
  "description": "Local-only, stage-gated product definition and quality engineering.",
  "version": "0.3.0",
  "publisher": "local-tools",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:productQuality.open"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "productQuality.open", "title": "Product Quality: Open Workflow" }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test dist/*.test.js",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
