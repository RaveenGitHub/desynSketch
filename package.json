{
  "name": "product-quality-workflow",
  "displayName": "Product Quality Workflow",
  "description": "Local-only, stage-gated product definition and quality engineering.",
  "version": "0.4.0",
  "publisher": "local-tools",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:productQuality.open"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "productQuality.open", "title": "Product Quality: Open Workflow" }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test dist/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "test:ui": "npm run compile && playwright test",
    "test:host": "npm run compile && node scripts/run-host-tests.cjs",
    "test:scale": "npm run compile && node --test tests/scale.test.cjs",
    "test:package": "npm run compile && node --test tests/package.test.cjs",
    "verify": "npm run lint && npm test && npm run test:scale && npm run test:ui && npm run test:package",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.71.2",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
